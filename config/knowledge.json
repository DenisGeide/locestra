{
  "schema_version": "1.0",
  "policy_version": "2026-07-15.2",
  "tracked_files_only": true,
  "allowed_root_files": [
    "README.md",
    "SYSTEM_MANIFEST.md",
    "compose.yml",
    "docker-compose.yml",
    "Cargo.toml",
    "CMakeLists.txt",
    "Gemfile",
    "Makefile",
    "composer.json",
    "go.mod",
    "go.sum",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "pyproject.toml",
    "requirements.txt",
    "yarn.lock"
  ],
  "allowed_directories": [
    "archives",
    "config",
    "constitution",
    "docs",
    "knowledge",
    "scripts",
    "services",
    "tests",
    "workflows"
  ],
  "allowed_extensions": [
    ".css",
    ".c",
    ".cc",
    ".cfg",
    ".conf",
    ".cpp",
    ".cs",
    ".dart",
    ".erl",
    ".ex",
    ".exs",
    ".fs",
    ".fsx",
    ".go",
    ".gql",
    ".gradle",
    ".graphql",
    ".h",
    ".hh",
    ".hpp",
    ".hrl",
    ".html",
    ".ini",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".kt",
    ".kts",
    ".lock",
    ".lua",
    ".md",
    ".mjs",
    ".mod",
    ".php",
    ".properties",
    ".proto",
    ".ps1",
    ".py",
    ".rb",
    ".rs",
    ".scala",
    ".sh",
    ".sql",
    ".sum",
    ".svelte",
    ".swift",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".vue",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "blocked_directory_names": [
    ".aws",
    ".azure",
    ".docker",
    ".git",
    ".kube",
    ".qwen",
    ".ssh",
    ".venv",
    "__pycache__",
    "backups",
    "build",
    "cache",
    "coverage",
    "data",
    "dist",
    "generated",
    "inbox",
    "logs",
    "models",
    "n8n_data",
    "node_modules",
    "open-webui_data",
    "outputs",
    "run",
    "vendor"
  ],
  "blocked_file_names": [
    ".env",
    ".env.example",
    "credentials",
    "credentials.json",
    "cookies",
    "cookies.json",
    "id_ed25519",
    "id_rsa"
  ],
  "blocked_file_suffixes": [
    ".db",
    ".gguf",
    ".key",
    ".log",
    ".onnx",
    ".pem",
    ".safetensors",
    ".sqlite",
    ".sqlite3"
  ],
  "max_file_bytes": 2097152,
  "max_total_bytes": 67108864,
  "max_fragment_chars": 1200,
  "max_fragments_per_source": 10000,
  "max_git_history_entries": 500,
  "max_tracked_files": 50000,
  "max_git_output_bytes": 16777216
}
