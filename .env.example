LOCAL_FAST_MODEL=local-fast
LOCAL_STRONG_MODEL=local-strong
LOCAL_AGENT_MODEL=local-strong
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
OLLAMA_BASE_URL=http://127.0.0.1:11434
FAST_OLLAMA_BASE_URL=http://127.0.0.1:11435
# Optional strict semantic-review identity pins; empty values use local auto-discovery/runtime hashing.
LOCESTRA_OLLAMA_EXECUTABLE=
LOCESTRA_OLLAMA_EXECUTABLE_SHA256=
GATEWAY_PORT=8787
VOICE_PORT=8788
OPEN_WEBUI_PORT=3737
N8N_PORT=5678
DEFAULT_PROJECT=
ENABLE_LOCAL_CODE_EXEC=true
# Optional cloud executor. Set true only after installing and authenticating Codex CLI.
ENABLE_CODEX_EXEC=false
CODEX_SANDBOX=workspace-write
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TELEGRAM_BOT_TOKEN=
GATEWAY_API_KEY=
TELEGRAM_GATEWAY_URL=http://127.0.0.1:8787/v1/chat/completions
TELEGRAM_VOICE_URL=http://127.0.0.1:8788/v1/audio/transcriptions
COMFYUI_URL=http://127.0.0.1:8388
MAX_AUTOMATIC_CHAT_TOOLS=8
TIMEZONE=UTC
